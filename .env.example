# Admin login for /admin.
#
# Generate the value with:
#   npm run make-admin-password -- "your password"
#
# The printed ADMIN_PASSWORD_HASH is the BASE64 of a bcrypt hash. It must stay
# base64 in this file: Next's .env parser treats the `$` characters inside a raw
# bcrypt hash as variable references and truncates the value, which makes every
# login fail even with the correct password. See lib/auth.ts.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=JDJiJDEyJHJlcGxhY2Vfd2l0aF9hX2Jhc2U2NF9oYXNo

# Supabase — the system of record for content, enquiries, subscribers and the
# email log. The service-role key must stay server-side (Vercel secret); every
# table has row-level security enabled with no public policies, so this key is
# the only path in or out. Without these variables the site falls back to the
# committed seed content and the in-memory inbox.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
