# Environment variables
#
# Copy this file to `.env.local` for local development, and set the same keys
# in Vercel → Project → Settings → Environment Variables for the deployment.
# `.env.local` is ignored by git. Never commit real values.

# ── Admin login ────────────────────────────────────────────────────────────
#
# The address you will type on the sign-in screen.
ADMIN_EMAIL=you@example.com

# The password, hashed. Generate it with:
#
#     npm run make-admin-password
#
# which prints a value like `tf1-210000-<salt>-<hash>`.
#
# ⚠ Do not use a bcrypt hash here. A bcrypt hash looks like
#   `$2b$12$…`, and env-file parsers — Next.js included — read `$` as the start
#   of a variable reference. The value is silently truncated at the first `$`,
#   so the hash arrives in the application as `""` or `"2b"` and every login
#   fails with "email or password is incorrect" while the password is correct.
#   The `tf1-` format above is entirely `[a-z0-9-]`, so it survives every parser.
#   (A bcrypt hash is still accepted if you paste one; it is repaired at
#   startup, but the tf1 format is what you should use.)
ADMIN_PASSWORD_HASH=tf1-210000-replace-with-the-output-of-npm-run-make-admin-password

# Signs the session cookie. Any long random string:
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Changing this signs everyone out. If it is absent the password hash is used
# as the signing key, which works but means rotating the password also signs
# everyone out.
ADMIN_SESSION_SECRET=

# ── Content storage ────────────────────────────────────────────────────────
#
# The CMS commits edits to a JSON file in the repository, and Vercel rebuilds.
# A fine-grained token with **Contents: read and write** on the repository.
# Without these three values the public site still builds from the committed
# `content/site.json`; only the admin write buttons stop working.
GITHUB_CONTENT_TOKEN=
GITHUB_CONTENT_REPO=kr8digitals/timfire
GITHUB_CONTENT_BRANCH=main

# The enquiry inbox is written to a separate branch so that a new message never
# triggers a deploy. Defaults to `admin-inbox`.
GITHUB_INBOX_BRANCH=admin-inbox

# ── Enquiry inbox encryption ───────────────────────────────────────────────
#
# Enquiries contain personal data, so each record is encrypted with
# AES-256-GCM before it is stored. Losing this key means losing the ability to
# read the messages that are already in the inbox — keep a copy in a password
# manager, not only in the host dashboard.
#
# Any long random string, ideally different from ADMIN_SESSION_SECRET:
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# If it is absent the inbox falls back to ADMIN_SESSION_SECRET.
INBOX_KEY=

# ── Optional ───────────────────────────────────────────────────────────────
# Public origin, used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://kutimfire.com
